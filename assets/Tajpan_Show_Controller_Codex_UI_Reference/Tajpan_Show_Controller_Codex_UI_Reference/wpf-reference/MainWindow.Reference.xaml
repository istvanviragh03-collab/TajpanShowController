<!--
REFERENCE STRUCTURE ONLY — NOT A DROP-IN REPLACEMENT.
Bind all values and commands to the existing MVVM layer.
Reuse the original Tajpán logo asset already present in the application if available.
-->
<Grid Background="{StaticResource Tajpan.WindowBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Background="{StaticResource Tajpan.HeaderBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Branding / top navigation / AUDIO+REMOTE summary -->
    </Grid>

    <!-- Playback page reference -->
    <Grid Grid.Row="1" Margin="18,14,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" MinWidth="610"/>
            <ColumnDefinition Width="11"/>
            <ColumnDefinition Width="0.82*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Playlist -->
        <Border Grid.Column="0" Style="{StaticResource Tajpan.Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="11"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header: PLAYLIST, Title, Path, New/Open/Save/Save As -->
                <!-- ItemsControl/ListView: drag handle | sequence | actual filename | duration -->
                <!-- Footer: + Add files | Remove | Drag to reorder -->
            </Grid>
        </Border>

        <!-- Right column -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="174"/>
                <RowDefinition Height="11"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact player -->
            <Border Grid.Row="0" Style="{StaticResource Tajpan.Card}" Padding="17,15">
                <!-- filename, elapsed/total, thin progress, Prev / Play-Pause / Stop / Next -->
            </Border>

            <!-- LCD + Audio + Remote -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="11"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="11"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <!-- Character LCD mirror -->
                <!-- Minimal Audio status -->
                <!-- Minimal Remote status -->
            </Grid>
        </Grid>
    </Grid>
</Grid>
