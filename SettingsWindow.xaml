<Window x:Class="TajpanShowController.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Controller beállítások" Width="760" Height="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Style="{StaticResource SectionHeading}" Text="CONTROLLER BEÁLLÍTÁSOK" Margin="0,0,0,24"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="250"/><Button Grid.Column="1" Content="Frissítés" Margin="12,0" Click="Refresh_Click"/><CheckBox Grid.Column="2" Content="Szimulációs mód" IsChecked="{Binding IsSimulation}" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18"><Button Content="Connect" Command="{Binding ConnectCommand}" MinWidth="120"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="120" Margin="12,0"/><TextBlock Text="192000 8N1" Foreground="{DynamicResource SecondaryBrush}" Margin="18,0"/></StackPanel><Grid Grid.Row="3" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SecondaryLabel}" Text="ÁLLAPOT"/><TextBlock Text="{Binding ConnectionLabel}" Margin="0,7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource SecondaryLabel}" Text="UTOLSÓ ÉRTELMEZETT VÁLASZ"/><TextBlock Text="{Binding LastResponse}" Margin="0,7"/></StackPanel></Grid><WrapPanel Grid.Row="4" Margin="0,0,0,12"><Button Content="START" Tag="10000000" Click="SimButton_Click"/><Button Content="STOP" Tag="01000000" Click="SimButton_Click" Margin="6,0"/><Button Content="PAUSE" Tag="00100000" Click="SimButton_Click"/><Button Content="PREV" Tag="00010000" Click="SimButton_Click" Margin="6,0"/><Button Content="NEXT" Tag="00001000" Click="SimButton_Click"/><Button Content="Hibás sor" Click="Malformed_Click" Margin="12,0,0,0"/><Button Content="NACK be/ki" Click="Nack_Click" Margin="6,0"/><Button Content="Kapcsolatvesztés" Click="Loss_Click"/></WrapPanel><ListBox Grid.Row="5" ItemsSource="{Binding Diagnostics}" FontFamily="Consolas" FontSize="13"/><StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="↑ Fel" Command="{Binding MoveUpCommand}"/><Button Content="↓ Le" Command="{Binding MoveDownCommand}" Margin="8,0"/><Button Content="Kijelölt eltávolítása" Command="{Binding RemoveCommand}"/><Button Content="Bezárás" Margin="16,0,0,0" Click="Close_Click"/></StackPanel></Grid>
</Window>
