<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TajpanShowController.App</AssemblyName>
    <RootNamespace>TajpanShowController</RootNamespace>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <ProjectReference Include="src\TajpanShowController.Core\TajpanShowController.Core.csproj" />
    <ProjectReference Include="src\TajpanShowController.Infrastructure\TajpanShowController.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\TajpanLogo.png">
      <Link>Assets\TajpanLogo.png</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="src\**\*;tests\**\*" />
    <None Remove="src\**\*;tests\**\*" />
    <Page Remove="assets\**\*.xaml" />
  </ItemGroup>

</Project>
