<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TajpanShowController">
  <local:PlayingIndicatorConverter x:Key="PlayingIndicatorConverter"/>
  <local:PlaylistSequenceConverter x:Key="PlaylistSequenceConverter"/>
  <SolidColorBrush x:Key="WindowBrush" Color="#090B0E"/><SolidColorBrush x:Key="HeaderBrush" Color="#0D1014"/><SolidColorBrush x:Key="PanelBrush" Color="#101419"/><SolidColorBrush x:Key="BorderBrush" Color="#272D34"/><SolidColorBrush x:Key="ControlBrush" Color="#171C22"/><SolidColorBrush x:Key="ControlBorderBrush" Color="#303842"/><SolidColorBrush x:Key="TextBrush" Color="#EDF0F3"/><SolidColorBrush x:Key="SecondaryBrush" Color="#A9B1B9"/><SolidColorBrush x:Key="MutedBrush" Color="#75808A"/><SolidColorBrush x:Key="VeryMutedBrush" Color="#59636D"/><SolidColorBrush x:Key="RedBrush" Color="#D62D32"/><SolidColorBrush x:Key="RedLightBrush" Color="#E45B60"/><SolidColorBrush x:Key="GreenBrush" Color="#4CDA82"/><SolidColorBrush x:Key="LcdBrush" Color="#ABC489"/><SolidColorBrush x:Key="LcdTextBrush" Color="#152012"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#1D242B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="HeaderTab" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#87919B"/><Setter Property="MinWidth" Value="88"/><Setter Property="Height" Value="58"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="PrimaryTransport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource RedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/><Setter Property="MinWidth" Value="58"/><Setter Property="Height" Value="38"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B0F13"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="SelectionBrush" Value="#6D2529"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="#10151A"/><Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="itemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemSurface" Property="Background" Value="#28313A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemSurface" Property="Background" Value="#54262A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#59636D"/><Setter TargetName="itemSurface" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ComboToggle" TargetType="ToggleButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="comboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="comboSurface" Property="Background" Value="#141A20"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="comboSurface" Property="BorderBrush" Value="#697581"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="comboSurface" Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0B0F13"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="toggle" Style="{StaticResource ComboToggle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Text="▼" Foreground="{TemplateBinding Foreground}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Grid></ToggleButton><Popup x:Name="popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#10151A" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="toggle" Property="BorderBrush" Value="#697581"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#59636D"/><Setter TargetName="toggle" Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource RedBrush}"/><Setter Property="Background" Value="#283038"/><Setter Property="Height" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Foreground}" BorderThickness="0" Height="4" VerticalAlignment="Center"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Height="4" VerticalAlignment="Center"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="16" Background="{TemplateBinding Foreground}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PlaybackSlider" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
    <Setter Property="Background" Value="#2B3239"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="3" Margin="5,0" Background="{TemplateBinding Background}" CornerRadius="1.5" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="5,0">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Foreground}" BorderThickness="0" Height="3" VerticalAlignment="Center"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Height="3" VerticalAlignment="Center"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="sliderThumb" Width="10" Height="10" Background="{DynamicResource RedBrush}" Opacity=".82">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="thumbSurface" Fill="{TemplateBinding Background}" Stroke="#F17478" StrokeThickness="1"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="thumbSurface" Property="Fill" Value="{DynamicResource RedLightBrush}"/><Setter TargetName="thumbSurface" Property="Stroke" Value="#F6A0A3"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="thumbSurface" Property="Fill" Value="#FF6B70"/><Setter TargetName="thumbSurface" Property="Stroke" Value="#FFFFFF"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sliderThumb" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PlaybackSeekSlider" TargetType="Slider" BasedOn="{StaticResource PlaybackSlider}"/>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#080B0E"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
</ResourceDictionary>
